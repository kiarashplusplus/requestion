# Cloud Functions runtime config.
#
# This replaces the removed `functions.config()` API (shut down with
# firebase-functions v7). Copy to `functions/.env` and fill in real values;
# Firebase loads `.env` into process.env automatically on deploy and in the
# emulator. `.env` is gitignored — never commit real secrets.
#
# For production, prefer Cloud Secret Manager for the secret values
# (CLOUDINARY_SECRET, NEWSAPI_ID) via firebase-functions params/defineSecret
# rather than a plaintext .env. See UPGRADE.md.

# Cloudinary (sticker -> hosted image overlays)
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# NewsAPI (https://newsapi.org) — powers /query and "Near you" headlines
NEWSAPI_ID=

# Optional: external Chrome websocket endpoint for Puppeteer. When set, the
# `sticker`/alternatives renderers connect to this browser instead of launching
# a bundled Chromium in the function (recommended on Cloud Functions — see
# UPGRADE.md "Puppeteer").
CHROME_WS=

# Optional: Azure Bing News key (bingNewsSearch is currently unused/dead code)
AZURE_ID=
